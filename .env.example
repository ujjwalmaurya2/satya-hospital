# SATYA HOSPITAL & PATHOLOGY — ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL PRODUCTION SECRETS OR SERVICE ROLE KEYS TO FRONTEND REPOSITORIES.

# 1. Supabase Backend
# Obtain from Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# 2. Cloudflare R2 / Private Storage Boundary (Server-Side / Edge Functions)
# Do NOT prefix private R2 secret access keys with VITE_ (keep server-side only)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=satya-hospital-records-private

# 3. Hospital Operational Parameters (Asia/Kolkata)
VITE_HOSPITAL_NAME="Satya Hospital & Pathology"
VITE_OPD_START_TIME="09:30"
VITE_ONLINE_CUTOFF_TIME="09:00"
VITE_MAX_DAILY_CAPACITY=60

# 4. Razorpay (server-side ONLY — set as Supabase Edge Function secrets, never VITE_)
#    supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=...
#    See supabase/README.md → "Online OPD booking & Razorpay payments".
